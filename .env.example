# Passk configuration. Copy to .env (git-ignored) and fill in values.
# Passk itself needs NO keys: it only reads logs. Keys are for the optional collect workflow.
NVIDIA_API_KEY=your-nvidia-key-here
GROQ_API_KEY=your-groq-key-here
CEREBRAS_API_KEY=your-cerebras-key-here
GEMINI_API_KEY=your-gemini-key-here
# Collector pacing (requests per minute = half the observed provider limit) and daily budget
PASSK_RPM=15
PASSK_DAILY_CALL_BUDGET=1500
# Optional OTLP endpoint for `passk report --otlp`
OTEL_EXPORTER_OTLP_ENDPOINT=
